<Window x:Class="Libertix.Dialogs.UnattendedWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        MaxHeight="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackground}"
        Title="{DynamicResource UnattendedWarningTitle}">
    <Border Margin="20"
            Padding="22"
            BorderThickness="3"
            BorderBrush="{StaticResource ErrorColor}"
            CornerRadius="8"
            Background="{StaticResource SecondaryBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource UnattendedWarningTitle}"
                       HorizontalAlignment="Center"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorColor}" />

            <ScrollViewer Grid.Row="2"
                          MaxHeight="400"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{DynamicResource UnattendedWarningMessage}"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NoButton"
                        AutomationProperties.AutomationId="UnattendedWarningNoButton"
                        Grid.Column="0"
                        Height="50"
                        TabIndex="0"
                        IsCancel="True"
                        Content="{DynamicResource ConfirmationNo}"
                        Style="{StaticResource ModernButton}"
                        Click="NoButton_Click" />
                <Button x:Name="YesButton"
                        AutomationProperties.AutomationId="UnattendedWarningYesButton"
                        Grid.Column="2"
                        Height="50"
                        TabIndex="1"
                        IsDefault="False"
                        Content="{DynamicResource ConfirmationYes}"
                        Background="{StaticResource ErrorColor}"
                        Style="{StaticResource ModernButton}"
                        Click="YesButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
