  <diagram id="libertix-simple" name="Libertix BIOS et UEFI">
    <mxGraphModel dx="1400" dy="1375" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1375" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Libertix — installation BIOS et UEFI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#25233A;strokeColor=#25233A;fontColor=#FFFFFF;fontSize=25;arcSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1260" height="70" as="geometry" /></mxCell>
        <mxCell id="start" value="&lt;b&gt;Libertix.exe sous Windows&lt;/b&gt;&lt;br&gt;Contrôle de compatibilité · choix du système, de la taille, du compte et du partage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=16;arcSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="125" width="700" height="78" as="geometry" /></mxCell>

        <mxCell id="biosBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;arcSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="255" width="600" height="980" as="geometry" /></mxCell>
        <mxCell id="uefiBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;arcSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="255" width="600" height="980" as="geometry" /></mxCell>

        <mxCell id="biosHeader" value="&lt;b&gt;BIOS / MBR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=20;arcSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="280" width="530" height="50" as="geometry" /></mxCell>
        <mxCell id="uefiHeader" value="&lt;b&gt;UEFI / GPT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=20;arcSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="280" width="530" height="50" as="geometry" /></mxCell>

        <mxCell id="b1" value="&lt;b&gt;1 · Réduire Windows C:&lt;/b&gt;&lt;br&gt;La taille choisie pour Linux devient de l’espace libre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;2 · Créer la partition live FAT32&lt;/b&gt;&lt;br&gt;Elle occupe directement l’emplacement final de Linux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="446" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;3 · Préparer les fichiers d’installation&lt;/b&gt;&lt;br&gt;Mini-live sur FAT32 · ISO Linux conservée sur C:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;4 · Programmer le prochain démarrage&lt;/b&gt;&lt;br&gt;BCD Windows lance GRUB4DOS une seule fois" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="638" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;5 · Redémarrer sur le live Libertix&lt;/b&gt;&lt;br&gt;Le mini-live démarre depuis la partition FAT32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="734" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b6" value="&lt;b&gt;6 · Revérifier le disque&lt;/b&gt;&lt;br&gt;Le live retrouve Windows, la partition live et la récupération" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="830" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b7" value="&lt;b&gt;7 · Transformer la partition en Linux&lt;/b&gt;&lt;br&gt;La même partition FAT32 est reformatée en ext4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="926" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b8" value="&lt;b&gt;8 · Installer et configurer Linux&lt;/b&gt;&lt;br&gt;ISO de C: extraite · compte, langue et partage appliqués" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1022" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="b9" value="&lt;b&gt;9 · Installer le démarrage final&lt;/b&gt;&lt;br&gt;GRUB BIOS est écrit sur le disque puis tout est vérifié" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1118" width="500" height="68" as="geometry" /></mxCell>

        <mxCell id="u1" value="&lt;b&gt;1 · Vérifier le firmware UEFI&lt;/b&gt;&lt;br&gt;Secure Boot, NVRAM, BootNext et accès à C:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u2" value="&lt;b&gt;2 · Réduire Windows C:&lt;/b&gt;&lt;br&gt;Toute la taille choisie pour Linux devient de l’espace libre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="446" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u3" value="&lt;b&gt;3 · Créer la partition live FAT32&lt;/b&gt;&lt;br&gt;LIBERTIXEFI utilise 8 Gio si Linux dépasse 31 Gio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="542" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u4" value="&lt;b&gt;4 · Préparer les fichiers d’installation&lt;/b&gt;&lt;br&gt;Mini-live sur LIBERTIXEFI · ISO Linux conservée sur C:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="638" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u5" value="&lt;b&gt;5 · Programmer le prochain démarrage&lt;/b&gt;&lt;br&gt;Chargeur temporaire dans l’ESP + BootNext vérifié" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="734" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u6" value="&lt;b&gt;6 · Redémarrer sur le live Libertix&lt;/b&gt;&lt;br&gt;Le firmware charge le mini-live une seule fois" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="830" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u7" value="&lt;b&gt;7 · Revérifier et agrandir la partition&lt;/b&gt;&lt;br&gt;Le boot temporaire est retiré puis FAT32 atteint la taille choisie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="926" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u8" value="&lt;b&gt;8 · Installer et configurer Linux&lt;/b&gt;&lt;br&gt;ext4 · ISO de C: extraite · compte, langue et partage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="1022" width="500" height="68" as="geometry" /></mxCell>
        <mxCell id="u9" value="&lt;b&gt;9 · Installer le démarrage final&lt;/b&gt;&lt;br&gt;GRUB UEFI signé est installé puis tout est vérifié" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#2E1065;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="1118" width="500" height="68" as="geometry" /></mxCell>

        <mxCell id="result" value="&lt;b&gt;Résultat : GRUB affiche Linux et Windows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;La partition de récupération est conservée. Pendant la préparation Windows, une erreur ou une annulation déclenche le rollback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=18;arcSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="1280" width="900" height="70" as="geometry" /></mxCell>

