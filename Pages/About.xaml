<Page x:Class="Libertix.Pages.About"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#232136">
    <Grid Margin="52,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource AboutTitle}"
                       Foreground="#E0DEF4"
                       FontSize="40"
                       FontWeight="Light"/>
            <TextBlock Text="{DynamicResource AboutSubtitle}"
                       Foreground="#908CAA"
                       FontSize="15"
                       Margin="0,8,0,22"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,18,0">
                <Border Background="#2A273F" CornerRadius="8" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AboutProjectHeading}"
                                   Foreground="#C4A7E7" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AboutProjectBody}"
                                   Foreground="#E0DEF4" FontSize="14" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="21"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2A273F" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AboutDevelopersHeading}"
                                       Foreground="#C4A7E7" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource AboutDevelopersBody}"
                                       Foreground="#E0DEF4" FontSize="14" Margin="0,8,0,0"
                                       TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#2A273F" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AboutDonorsHeading}"
                                       Foreground="#C4A7E7" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource AboutDonorsBody}"
                                       Foreground="#E0DEF4" FontSize="14" Margin="0,8,0,0"
                                       TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Back}"
                    Style="{StaticResource ModernButton}" Width="130" Height="42"
                    Click="Back_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource AboutWebsiteButton}"
                        Style="{StaticResource ModernButton}" Width="140" Height="42"
                        Margin="0,0,10,0" Tag="https://ekimia.fr/libertix/"
                        Click="OpenLink_Click"/>
                <Button Content="{DynamicResource AboutDonateButton}"
                        Style="{StaticResource ModernButton}" Width="140" Height="42"
                        Margin="0,0,10,0" Tag="https://ekimia.fr/donations/campagne-libertix/"
                        Click="OpenLink_Click"/>
                <Button Content="GitHub"
                        Style="{StaticResource ModernButton}" Width="120" Height="42"
                        Tag="https://github.com/ekimiateam/libertix"
                        Click="OpenLink_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
