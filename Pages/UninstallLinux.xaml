<Page x:Class="Libertix.Pages.UninstallLinux"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PrimaryBackground}"
      Loaded="Page_Loaded">
    <Grid Margin="52,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource UninstallLinuxTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="48"
                       FontWeight="Light"
                       TextAlignment="Center"/>
            <TextBlock x:Name="DescriptionText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,28"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22">
            <StackPanel>
                <TextBlock x:Name="CurrentStepText"
                           Text="{DynamicResource UninstallLinuxPreparing}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar"
                             AutomationProperties.AutomationId="UninstallLinuxProgressBar"
                             Height="22"
                             Minimum="0"
                             Maximum="100"
                             Value="5"
                             Margin="0,18,0,0"
                             Foreground="{DynamicResource AccentColor}"
                             Background="{DynamicResource PanelBorder}"/>
                <TextBox x:Name="LogOutput"
                         Height="250"
                         Margin="0,18,0,0"
                         Background="{DynamicResource DeepBackground}"
                         Foreground="{DynamicResource TextSecondary}"
                         BorderBrush="{DynamicResource PanelBorder}"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,26,0,0">
            <Button x:Name="BackButton"
                    Content="{DynamicResource Back}"
                    Style="{StaticResource ModernButton}"
                    Width="210"
                    Height="52"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="BackButton_Click"/>
            <Button x:Name="RetryButton"
                    Content="{DynamicResource UninstallLinuxRetry}"
                    AutomationProperties.AutomationId="UninstallLinuxRetryButton"
                    Style="{StaticResource ModernButton}"
                    Width="250"
                    Height="52"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Click="RetryButton_Click"/>
            <Button x:Name="DoneButton"
                    Content="{DynamicResource UninstallLinuxDone}"
                    AutomationProperties.AutomationId="UninstallLinuxDoneButton"
                    Style="{StaticResource ModernButton}"
                    Width="250"
                    Height="52"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Click="BackButton_Click"/>
        </Grid>
    </Grid>
</Page>
