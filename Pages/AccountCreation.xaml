<Page x:Class="Libertix.Pages.AccountCreation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Libertix.Pages"
      mc:Ignorable="d"
      Title="Create Account"
      KeyboardNavigation.TabNavigation="Cycle"
      Loaded="AccountCreation_Loaded"
      PreviewKeyDown="AccountCreation_PreviewKeyDown">

    <Page.Resources>
        <!-- An empty message must not reserve height: the form only fits the fixed
             window when space is spent on errors that are actually shown. The fixed
             gap between fields belongs to the labels so it survives a hidden message. -->
        <Style x:Key="FieldErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource PrimaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="{DynamicResource AccountCreationTitle}"
               HorizontalAlignment="Center"
               Margin="20"
               FontSize="48"
               FontWeight="Light"
               Foreground="{DynamicResource TextPrimary}"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="400"
                    VerticalAlignment="Center">

            <Label Content="{DynamicResource Username}"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox"
                     MaxLength="32"
                     TabIndex="0"
                     Height="40"
                     FontSize="16"
                     Padding="10,5"
                     Background="{DynamicResource SecondaryBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource PanelBorder}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"
                     TextChanged="ValidateInput">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock x:Name="UsernameError"
                       Style="{StaticResource FieldErrorText}"/>

            <Label Content="{DynamicResource Password}"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   Margin="0,15,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         MaxLength="128"
                         TabIndex="1"
                         Height="40"
                         FontSize="16"
                         Padding="10,5"
                         Background="{DynamicResource SecondaryBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource PanelBorder}"
                         BorderThickness="1"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         PasswordChanged="ValidateInput">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
            <TextBlock x:Name="PasswordError"
                       Style="{StaticResource FieldErrorText}"/>

            <Label Content="{DynamicResource ConfirmPassword}"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   Margin="0,15,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         MaxLength="128"
                         TabIndex="2"
                         Height="40"
                         FontSize="16"
                         Padding="10,5"
                         Background="{DynamicResource SecondaryBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource PanelBorder}"
                         BorderThickness="1"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         PasswordChanged="ValidateInput">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
            <TextBlock x:Name="ConfirmPasswordError"
                       Style="{StaticResource FieldErrorText}"/>

            <Label Content="{DynamicResource ComputerName}"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="16"
                   Margin="0,15,0,5"/>
            <TextBox x:Name="HostnameBox"
                     MaxLength="63"
                     TabIndex="3"
                     Height="40"
                     FontSize="16"
                     Padding="10,5"
                     Background="{DynamicResource SecondaryBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource PanelBorder}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"
                     TextChanged="ValidateInput">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock x:Name="HostnameError"
                       Style="{StaticResource FieldErrorText}"/>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="{DynamicResource Back}"
                    Style="{StaticResource ModernButton}"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Left"
                    TabIndex="4"
                    Click="BackButton_Click"/>

            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Content="{DynamicResource Next}"
                    Style="{StaticResource ModernButton}"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Right"
                    TabIndex="5"
                    IsDefault="True"
                    Click="NextButton_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
