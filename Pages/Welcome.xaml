<Page x:Class="Libertix.Pages.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PrimaryBackground}"
      KeyboardNavigation.TabNavigation="Cycle"
      Loaded="Welcome_Loaded">
    <Grid Background="{DynamicResource PrimaryBackground}">
        <StackPanel VerticalAlignment="Center">
            <Label Content="{DynamicResource Welcome}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"
                   FontSize="72"
                   FontWeight="Light"
                   Foreground="{DynamicResource TextPrimary}"/>

            <Label Content="{DynamicResource Subtitle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   FontSize="16"
                   FontWeight="Light"
                   Foreground="{DynamicResource TextSecondary}"/>

            <Button x:Name="StartButton"
                    Content="{DynamicResource GetStarted}"
                    AutomationProperties.AutomationId="StartInstallationButton"
                    Style="{StaticResource ModernButton}"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40"
                    TabIndex="0"
                    IsDefault="True"
                    Click="Start_Click"/>

            <Border x:Name="InstalledLinuxPanel"
                    Visibility="Collapsed"
                    Width="620"
                    Margin="0,0,0,32"
                    Padding="22"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="InstalledLinuxText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="17"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>
                    <Button x:Name="UninstallButton"
                            Content="{DynamicResource UninstallLinuxButton}"
                            AutomationProperties.AutomationId="UninstallLinuxButton"
                            Style="{StaticResource ModernButton}"
                            Width="250"
                            Height="50"
                            HorizontalAlignment="Center"
                            Click="Uninstall_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Language}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="LanguageComboBox"
                          AutomationProperties.AutomationId="LanguageComboBox"
                          Width="120"
                          TabIndex="1"
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="LanguageComboBox_SelectionChanged"/>
            </StackPanel>

        </StackPanel>

        <Button Content="{DynamicResource AboutButton}"
                Style="{StaticResource ModernButton}"
                Width="160"
                Height="42"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                TabIndex="2"
                Click="About_Click"/>
    </Grid>
</Page>
