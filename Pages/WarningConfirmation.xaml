<Page x:Class="Libertix.Pages.WarningConfirmation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Libertix.Pages"
      mc:Ignorable="d"
      Title="{DynamicResource WarningTitle}">

    <Grid Background="{DynamicResource PrimaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="{DynamicResource WarningTitle}"
               HorizontalAlignment="Center"
               Margin="20"
               FontSize="48"
               FontWeight="Light"
               Foreground="{DynamicResource ErrorColor}"/>

        <StackPanel Grid.Row="1"
                    Width="600"
                    VerticalAlignment="Center">

            <Border Background="{DynamicResource SecondaryBackground}"
                    CornerRadius="8"
                    Padding="20"
                    BorderBrush="{DynamicResource ErrorColor}"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WarningMessage}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource WarningRisks}"
                               Foreground="{DynamicResource WarningColor}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource WarningRecommendations}"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="HibernationNotice"
                               Text="{DynamicResource WarningHibernationNotice}"
                               Foreground="{DynamicResource WarningColor}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Left"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="ConfirmCheckBox"
                      Margin="0,20,0,0"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="14"
                      Checked="ConfirmCheckBox_Changed"
                      Unchecked="ConfirmCheckBox_Changed">
                <TextBlock Text="{DynamicResource WarningConfirmCheckbox}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
            </CheckBox>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="{DynamicResource Back}"
                    Style="{StaticResource ModernButton}"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click"/>

            <Button x:Name="ConfirmButton"
                    Grid.Column="1"
                    Content="{DynamicResource WarningConfirmButton}"
                    Style="{StaticResource ModernButton}"
                    Width="200"
                    Height="50"
                    HorizontalAlignment="Right"
                    Click="ConfirmButton_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
