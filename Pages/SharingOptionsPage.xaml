<Page x:Class="Libertix.Pages.SharingOptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="File sharing"
      KeyboardNavigation.TabNavigation="Cycle"
      Loaded="SharingOptionsPage_Loaded"
      PreviewKeyDown="SharingOptionsPage_PreviewKeyDown">
    <Grid Background="{DynamicResource PrimaryBackground}" Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,20,0,35">
            <TextBlock Text="{DynamicResource SharingTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="46"
                       FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource SharingDescription}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="80,0">
        <StackPanel VerticalAlignment="Center">
            <CheckBox x:Name="WindowsToLinuxCheckBox"
                      IsChecked="True"
                      TabIndex="0"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="19"
                      Margin="0,0,0,30">
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource SharingWindowsToLinuxTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource SharingWindowsToLinuxDescription}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="LinuxToWindowsCheckBox"
                      IsChecked="True"
                      TabIndex="1"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="19"
                      Margin="0,0,0,30">
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource SharingLinuxToWindowsTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource SharingLinuxToWindowsDescription}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox x:Name="MigrateWindowsPreferencesCheckBox"
                      IsChecked="False"
                      TabIndex="2"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="19">
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource SharingMigratePreferencesTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource SharingMigratePreferencesDescription}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,30,0,10">
            <Button Content="{DynamicResource Back}"
                    Style="{StaticResource ModernButton}"
                    Width="180" Height="48"
                    HorizontalAlignment="Left"
                    TabIndex="3"
                    Click="BackButton_Click"/>
            <Button x:Name="NextButton"
                    Content="{DynamicResource Next}"
                    Style="{StaticResource ModernButton}"
                    Width="180" Height="48"
                    HorizontalAlignment="Right"
                    TabIndex="4"
                    IsDefault="True"
                    Click="NextButton_Click"/>
        </Grid>
    </Grid>
</Page>
