<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- The shared downloader intentionally targets Windows PowerShell/.NET Framework. -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <ProjectReference Include="../Server/Libertix.InstallParty.csproj" />
    <Compile Include="../../Scripts/native/LocalFilepoolDownload.cs" Link="LocalFilepoolDownload.cs" />
    <Compile Include="../../Helpers/LocalFilepoolDiscovery.cs" Link="LocalFilepoolDiscovery.cs" />
    <None Include="../../Libertix.Tests/TestData/catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Libertix.Tests/TestData/catalog.json.sig" Link="catalog.json.sig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
