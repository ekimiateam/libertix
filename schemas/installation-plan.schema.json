{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekimia.fr/libertix/schemas/installation-plan-v3.json",
  "title": "Libertix Installation Plan",
  "description": "Versioned contract shared by the Windows application, the live installer, the installed target and rollback tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "createdAtUtc",
    "firmware",
    "distribution",
    "locale",
    "account",
    "disk",
    "features",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "planId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "firmware": {
      "enum": [
        "bios",
        "uefi"
      ]
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "account": {
      "$ref": "#/$defs/account"
    },
    "disk": {
      "$ref": "#/$defs/disk"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "development": {
      "$ref": "#/$defs/development"
    }
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "osReleaseId",
        "grubDisplayName",
        "grubIcon",
        "secureBootMicrosoftAuthorities",
        "installerIsoFileName",
        "installerIsoUrl",
        "installerIsoWindowsPath",
        "installerIsoSha256",
        "liveIsoUrl",
        "liveIsoSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "osReleaseId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "grubDisplayName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,79}$"
        },
        "grubIcon": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "secureBootMicrosoftAuthorities": {
          "$ref": "#/$defs/microsoftUefiAuthorities"
        },
        "installerIsoFileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "installerIsoUrl": {
          "type": "string",
          "minLength": 1
        },
        "installerIsoWindowsPath": {
          "type": "string",
          "pattern": "^[A-Za-z]:[\\\\/]"
        },
        "installerIsoSha256": {
          "$ref": "#/$defs/sha256"
        },
        "liveIsoUrl": {
          "type": "string",
          "minLength": 1
        },
        "liveIsoSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageCode",
        "systemLanguage",
        "keyboardLayout",
        "keyboardModel",
        "timezone"
      ],
      "properties": {
        "languageCode": {
          "type": "string",
          "enum": ["en", "fr", "es"]
        },
        "systemLanguage": {
          "type": "string",
          "minLength": 1
        },
        "keyboardLayout": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "keyboardVariant": {
          "type": "string",
          "pattern": "^[a-z0-9_-]*$"
        },
        "keyboardModel": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+$"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "passwordHashWindowsPath",
        "computerName"
      ],
      "properties": {
        "username": {
          "type": "string",
          "description": "The shared installation policy additionally rejects Debian/Ubuntu system account and group names.",
          "pattern": "^[a-z](?:[a-z0-9-]{0,30}[a-z0-9])?$"
        },
        "passwordHashWindowsPath": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\"
        },
        "computerName": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "uniqueId",
        "partitionTableId",
        "sizeBytes",
        "logicalSectorSizeBytes",
        "partitionStyle",
        "systemDrive",
        "windows",
        "boot",
        "recovery",
        "installer"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueId": {
          "type": "string",
          "minLength": 1
        },
        "partitionTableId": {
          "type": "string",
          "pattern": "^(?:mbr:[0-9a-f]{8}|gpt:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        },
        "sizeBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "logicalSectorSizeBytes": {
          "enum": [
            512,
            4096
          ]
        },
        "partitionStyle": {
          "enum": [
            "MBR",
            "GPT"
          ]
        },
        "systemDrive": {
          "type": "string",
          "pattern": "^[A-Z]:$"
        },
        "windows": {
          "$ref": "#/$defs/partitionIdentity"
        },
        "boot": {
          "$ref": "#/$defs/partitionIdentity"
        },
        "recovery": {
          "$ref": "#/$defs/partitionIdentity"
        },
        "installer": {
          "$ref": "#/$defs/installerPartition"
        }
      }
    },
    "partitionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "offsetBytes",
        "sizeBytes"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "offsetBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "sizeBytes": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "installerPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "offsetBytes",
        "finalOffsetBytes",
        "resizeMode",
        "finalSizeBytes",
        "stagingSizeBytes"
      ],
      "properties": {
        "number": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "offsetBytes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/positiveInteger"
            }
          ]
        },
        "finalOffsetBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "resizeMode": {
          "enum": [
            "windows-online",
            "live-offline"
          ]
        },
        "finalSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "multipleOf": 1073741824
        },
        "stagingSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "multipleOf": 1073741824
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shareWindowsFilesInLinux",
        "shareLinuxFilesInWindows",
        "windowsProfilesJsonBase64"
      ],
      "properties": {
        "shareWindowsFilesInLinux": {
          "type": "boolean"
        },
        "shareLinuxFilesInWindows": {
          "type": "boolean"
        },
        "windowsProfilesJsonBase64": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowsBitLockerState",
        "lowMemoryMode",
        "bootStrategy",
        "secureBootEnabled",
        "trustedMicrosoftUefiAuthorities",
        "recoveryRootWindows",
        "recoveryRunId"
      ],
      "properties": {
        "windowsBitLockerState": {
          "enum": [
            "FullyDecrypted",
            "NotEncryptable"
          ]
        },
        "lowMemoryMode": {
          "type": "boolean"
        },
        "bootStrategy": {
          "enum": [
            "bios-grub4dos",
            "uefi-boot-next",
            "uefi-firmware-boot-order"
          ]
        },
        "secureBootEnabled": {
          "type": "boolean"
        },
        "trustedMicrosoftUefiAuthorities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["2011", "2023"]
          }
        },
        "recoveryRootWindows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]:\\\\"
        },
        "recoveryRunId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "microsoftUefiAuthorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["2011", "2023"]
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enableSsh",
        "staticIpv4Address",
        "staticIpv4PrefixLength",
        "staticIpv4Gateway",
        "dnsServers"
      ],
      "properties": {
        "enableSsh": {
          "const": true
        },
        "staticIpv4Address": {
          "$ref": "#/$defs/ipv4"
        },
        "staticIpv4PrefixLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "staticIpv4Gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "dnsServers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ipv4"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "firmware": {
            "const": "bios"
          }
        },
        "required": [
          "firmware"
        ]
      },
      "then": {
        "properties": {
          "disk": {
            "properties": {
              "partitionStyle": {
                "const": "MBR"
              },
              "partitionTableId": {
                "pattern": "^mbr:[0-9a-f]{8}$"
              }
            }
          },
          "runtime": {
            "properties": {
              "bootStrategy": {
                "const": "bios-grub4dos"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "firmware": {
            "const": "uefi"
          }
        },
        "required": [
          "firmware"
        ]
      },
      "then": {
        "properties": {
          "disk": {
            "properties": {
              "partitionStyle": {
                "const": "GPT"
              },
              "partitionTableId": {
                "pattern": "^gpt:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          },
          "runtime": {
            "properties": {
              "bootStrategy": {
                "enum": [
                  "uefi-boot-next",
                  "uefi-firmware-boot-order"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
