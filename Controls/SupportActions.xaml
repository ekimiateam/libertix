<UserControl x:Class="Libertix.Controls.SupportActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,10,0,0">
        <WrapPanel>
            <Button x:Name="CopyButton" Style="{StaticResource ModernButton}"
                    AutomationProperties.AutomationId="CopySupportReportButton"
                    Padding="14,8" Margin="0,0,10,6" Click="Copy_Click"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,6">
                <Hyperlink Click="Issue_Click" Foreground="{DynamicResource AccentColor}">
                    <Run x:Name="IssueLinkText"/>
                </Hyperlink>
            </TextBlock>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
</UserControl>
