<Window x:Class="Libertix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libertix"
        mc:Ignorable="d"
        Title="Libertix"
        Height="630" Width="1070"
        MinHeight="630" MinWidth="1070"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource PrimaryBackground}"/>

        <Border x:Name="DevelopmentModeBanner"
                Height="32"
                VerticalAlignment="Top"
                Background="#3A2400"
                BorderBrush="#FFF0A234"
                BorderThickness="0,0,0,1"
                IsHitTestVisible="False"
                Panel.ZIndex="1000"
                Visibility="Collapsed">
            <TextBlock x:Name="DevelopmentModeBannerText"
                       Text="DEVELOPMENT MODE - catalog signature verification is disabled."
                       Foreground="#FFFFB347"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
